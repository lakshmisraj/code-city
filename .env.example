# Copy this file to .env (which git ignores) and fill in your own values.
# Used only by dev-server.mjs on your own machine.

# A GitHub token that signs the dev page in as you. A fine-grained token with no extra
# permissions is enough: Code City only asks GitHub whose token it is.
# Create one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Your Gemini API key (Google AI Studio), so Ask, tours and explanations run the dev copy
# of netlify/functions/ask.mjs. Leave it empty to run without Ask.
GEMINI_API_KEY=
